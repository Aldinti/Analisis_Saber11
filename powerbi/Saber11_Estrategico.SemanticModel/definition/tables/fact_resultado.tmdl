/// Una fila por evaluación. Se lee la carpeta particionada anio/periodo (columnas incluidas en los archivos, ADR-0005).
table fact_resultado
	lineageTag: bc871d93-a419-4ffa-a339-d4fb734a38b1

	column resultado_id
		dataType: int64
		isHidden
		lineageTag: 1cf2558b-9206-4842-97af-031d68b3006b
		sourceColumn: resultado_id

	column tiempo_id
		dataType: int64
		isHidden
		lineageTag: 81e695b1-28b8-4cba-ae51-3198cf093ecb
		sourceColumn: tiempo_id

	column colegio_id
		dataType: int64
		isHidden
		lineageTag: 5ba825b7-776a-40da-a812-1e6e0e2b1874
		sourceColumn: colegio_id

	column ubicacion_id
		dataType: int64
		isHidden
		lineageTag: 6685cada-a29a-4238-9499-7da7dd0ff2cd
		sourceColumn: ubicacion_id

	column perfil_id
		dataType: int64
		isHidden
		lineageTag: 6de43724-e35d-44f6-87d5-c8ea730d45a4
		sourceColumn: perfil_id

	column grupo
		dataType: string
		lineageTag: 9f2cc176-f147-4948-a0ae-50130d0f12e5
		sourceColumn: grupo

	column puntaje_global
