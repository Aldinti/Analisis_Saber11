	column anio
		dataType: int64
		isHidden
		lineageTag: c9e2c65b-c5f5-45c8-b715-9cc7575966ee
		summarizeBy: none
		sourceColumn: anio

	column periodo
		dataType: string
		isHidden
		lineageTag: 7588eac0-c118-4a63-962a-f5f687a2af0f
		sourceColumn: periodo

	/// Inicio del rango de 25 puntos (orden del histograma).
	column rango_global_inicio = INT ( fact_resultado[puntaje_global] / 25 ) * 25
		dataType: int64
		isHidden
		lineageTag: e5677437-8af6-4bcd-9a63-349c4a25732d
		summarizeBy: none

	/// Rango de 25 puntos del puntaje global para el histograma (p. ej. 400-424).
	column rango_global =
			VAR Inicio = INT ( fact_resultado[puntaje_global] / 25 ) * 25
			RETURN FORMAT ( Inicio, "0" ) & "-" & FORMAT ( MIN ( Inicio + 24, 500 ), "0" )
		dataType: string
		lineageTag: 13b6cca5-a8b6-418e-b251-aa8741a20833
		sortByColumn: rango_global_inicio

	partition fact_resultado = m
		mode: import
		source =
				let
				    Archivos = Folder.Files(RutaGold & "\fact_resultado"),
				    SoloParquet = Table.SelectRows(Archivos, each Text.Lower([Extension]) = ".parquet"),
				    Tablas = List.Transform(SoloParquet[Content], each Parquet.Document(_)),
				    Combinada = Table.Combine(Tablas),
				    Tipos = Table.TransformColumnTypes(Combinada, {{"resultado_id", Int64.Type}, {"tiempo_id", Int64.Type}, {"colegio_id", Int64.Type}, {"ubicacion_id", Int64.Type}, {"perfil_id", Int64.Type}, {"grupo", type text}, {"puntaje_global", Int64.Type}, {"punt_lectura_critica", Int64.Type}, {"punt_matematicas", Int64.Type}, {"punt_sociales", Int64.Type}, {"punt_ciencias", Int64.Type}, {"punt_ingles", Int64.Type}, {"anio", Int64.Type}, {"periodo", type text}})
				in
				    Tipos

