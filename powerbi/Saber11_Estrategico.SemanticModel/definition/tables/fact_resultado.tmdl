		lineageTag: a64c3376-d1c3-475b-996f-e72e4a7ec17d
		sourceColumn: punt_lectura_critica

	column punt_matematicas
		dataType: int64
		lineageTag: 7caec9ee-d6f7-41e1-9a86-61bbd098729b
		sourceColumn: punt_matematicas

	column punt_sociales
		dataType: int64
		lineageTag: 09956941-ab20-46b4-858b-9ef8a45d7b70
		sourceColumn: punt_sociales

	column punt_ciencias
		dataType: int64
		lineageTag: 4d0eacd5-a823-4655-8786-f03853d73861
		sourceColumn: punt_ciencias

