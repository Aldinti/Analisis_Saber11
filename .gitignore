# Entorno virtual
.venv/
env/
venv/

# Python cache y compilados
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# Datos (CONFIDENCIAL / PII / VOLUMEN)
data/
*.parquet
*.csv
!config/*.csv
config/seguridad_rectores.csv
!tests/fixtures/*.csv
!reports/bi/*.csv
!reports/ml/*.csv
*.tmp

# Secretos y credenciales
.env
.env.local
*.key
*.pem

# Artefactos de modelos por run_id: se regeneran con `run --stage ml`.
# La evidencia versionada vive en reports/ml/ (informe y métricas por pliegue).
models/

# Power BI (Archivos locales con datos en caché)
*.pbix

# IDEs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Power BI Project (PBIP): cache con datos importados y ajustes locales/firmas
powerbi/**/.pbi/cache.abf
powerbi/**/.pbi/localSettings.json
